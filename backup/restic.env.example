# restic.env.example - template for the backup job's secrets.
# Copy to /mnt/SSDs/houseos/backup/restic.env on the server, then:
#   sudo chown root:root restic.env && sudo chmod 600 restic.env
# NEVER commit the real file.
#
# Read by `docker run --env-file`. Format rules:
#   KEY=value   no quotes (they become part of the value), no spaces around =, no "export"

# Where backups go: rest-server on the PC. The login is NOT in the URL.
RESTIC_REPOSITORY=rest:https://PC_LAN_IP:8000/gaia/

# rest-server login - Bitwarden: "rest-server login (Gaia -> PC)"
RESTIC_REST_USERNAME=gaia
RESTIC_REST_PASSWORD=

# Encryption password for the backup repository.
# Bitwarden: "restic backup encryption (Gaia)" + paper sheet.
# If this is lost, the backups can never be read again.
RESTIC_PASSWORD=
